# ==== 便携版运行时（体积过大，不入库）====
# 内置 Node.js 运行时（约 86 MB）
/core/node/
# 内置 Python 运行时（约 64 MB）
/core/python/
# Python 虚拟环境
**/.venv/
**/venv/

# ==== Python 缓存 ====
__pycache__/
*.py[cod]
*.egg-info/

# ==== 运行期数据与日志 ====
/core/Alogorithm-main/logs/
*.log
# 平台登录凭据（各平台登录后写入，含 cookie / token）
/core/kuwoMusicApi/live/data/
/core/QQMusicApi/live/data/

# ==== 旧版本残留 ====
# 程序已不再读取（主配置入口是根目录 config.json，见 core/Alogorithm-main/core/config.js）
/core/Alogorithm-main/config.json
# 与 core/platform-ports.json 内容完全重复，程序只读那份（见 core/Alogorithm-main/core/config.js）
/core/Alogorithm-main/platform-ports.json

# ==== 上游第三方项目的仓库元数据（与本项目无关，不随包分发）====
/core/KuGouMusicApi/.github/
/core/QQMusicApi/.github/
/core/QQMusicApi/.agents/
/core/kuwoMusicApi/.github/
/core/kuwoMusicApi/.vscode/

# ==== 系统与编辑器杂物 ====
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~
